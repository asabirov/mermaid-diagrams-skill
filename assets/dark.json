{
  "theme": "base",
  "securityLevel": "strict",
  "themeVariables": {
    "darkMode": true,
    "fontFamily": "Geist, Arial, sans-serif",
    "fontSize": "20px",
    "background": "#0a0a0a",
    "primaryColor": "#1a1a1a",
    "primaryTextColor": "#ededed",
    "primaryBorderColor": "#1a1a1a",
    "secondaryColor": "#1a1a1a",
    "secondaryTextColor": "#ededed",
    "secondaryBorderColor": "#1a1a1a",
    "tertiaryColor": "#1a1a1a",
    "tertiaryTextColor": "#ededed",
    "tertiaryBorderColor": "#1a1a1a",
    "lineColor": "#a1a1a1",
    "textColor": "#ededed",
    "edgeLabelBackground": "#0a0a0a",
    "actorBkg": "#10243e",
    "actorBorder": "#10243e",
    "actorTextColor": "#ededed",
    "actorLineColor": "#a1a1a1",
    "signalColor": "#a1a1a1",
    "signalTextColor": "#ededed",
    "labelBoxBkgColor": "#1a1a1a",
    "labelBoxBorderColor": "#1a1a1a",
    "labelTextColor": "#ededed",
    "loopTextColor": "#ededed",
    "noteBkgColor": "#1a1a1a",
    "noteTextColor": "#ededed",
    "noteBorderColor": "#1a1a1a",
    "activationBkgColor": "#1a1a1a",
    "activationBorderColor": "#a1a1a1"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 36,
    "rankSpacing": 48
  },
  "sequence": {
    "mirrorActors": false,
    "wrap": true
  },
  "themeCSS": ".decision rect,.decision polygon,.decision path,.decision circle,.decision ellipse{fill:#10243e!important;stroke:none!important} .result rect,.result polygon,.result path,.result circle,.result ellipse{fill:#102d29!important;stroke:none!important} .edgeLabel rect{fill:#0a0a0a!important;opacity:1!important} .edgeLabel text{paint-order:stroke;stroke:#0a0a0a;stroke-width:6px;stroke-linejoin:round}"
}
