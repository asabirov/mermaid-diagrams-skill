{
  "theme": "base",
  "fontSize": 20,
  "securityLevel": "strict",
  "themeVariables": {
    "darkMode": false,
    "fontFamily": "Geist, Arial, sans-serif",
    "fontSize": "20px",
    "background": "#ffffff",
    "primaryColor": "#f2f2f2",
    "primaryTextColor": "#171717",
    "primaryBorderColor": "#f2f2f2",
    "secondaryColor": "#f2f2f2",
    "secondaryTextColor": "#171717",
    "secondaryBorderColor": "#f2f2f2",
    "tertiaryColor": "#f2f2f2",
    "tertiaryTextColor": "#171717",
    "tertiaryBorderColor": "#f2f2f2",
    "lineColor": "#737373",
    "textColor": "#171717",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#edf5ff",
    "actorBorder": "#edf5ff",
    "actorTextColor": "#171717",
    "actorLineColor": "#737373",
    "signalColor": "#737373",
    "signalTextColor": "#171717",
    "labelBoxBkgColor": "#f2f2f2",
    "labelBoxBorderColor": "#f2f2f2",
    "labelTextColor": "#171717",
    "loopTextColor": "#171717",
    "noteBkgColor": "#f2f2f2",
    "noteTextColor": "#171717",
    "noteBorderColor": "#f2f2f2",
    "activationBkgColor": "#f2f2f2",
    "activationBorderColor": "#737373"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 36,
    "rankSpacing": 48
  },
  "sequence": {
    "mirrorActors": false,
    "wrap": true
  },
  "themeCSS": ".decision rect,.decision polygon,.decision path,.decision circle,.decision ellipse{fill:#edf5ff!important;stroke:none!important} .result rect,.result polygon,.result path,.result circle,.result ellipse{fill:#e9f7f3!important;stroke:none!important} .edgeLabel rect{fill:#ffffff!important;opacity:1!important} .edgeLabel text{paint-order:stroke;stroke:#ffffff;stroke-width:6px;stroke-linejoin:round}"
}
